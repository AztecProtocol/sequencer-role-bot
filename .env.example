# Copy to .env and fill in. Do not commit .env.

# --- Discord ---------------------------------------------------------------
# Bot token and application id, from the Discord developer portal.
# The application needs no privileged intent. Leave "Server Members",
# "Presence" and "Message Content" switched off in the developer portal.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# The server (guild) the bot works in.
DISCORD_GUILD_ID=
# Role granted after a successful registration, one per network.
# The two ids must be different. The bot's own role must be above both.
MAINNET_SEQUENCER_ROLE_ID=
TESTNET_SEQUENCER_ROLE_ID=
# Channel for registration and status log messages.
ADMIN_LOG_CHANNEL_ID=

# --- Ethereum (L1) ---------------------------------------------------------
# The bot reads the Aztec rollup contract on Ethereum L1. It resolves the
# current rollup from the registry, so a network upgrade needs no change here.
# Use Ethereum RPC endpoints, NOT Aztec node endpoints. For example, on dRPC
# the path starts with /ethereum/ and /sepolia/, not /aztec-mainnet/.
# Mainnet: an Ethereum mainnet RPC.
AZTEC_MAINNET_RPC_URL=
AZTEC_MAINNET_REGISTRY_CONTRACT=0x35b22e09ee0390539439e24f06da43d83f90e298
# Testnet: an Ethereum Sepolia RPC.
AZTEC_RPC_URL=
AZTEC_REGISTRY_CONTRACT=0xa0bfb1b494fb49041e5c6e8c2c1be09cd171c6ba

# Provider registration. The StakingRegistry is not reachable from the
# registry, so it is configured here. Check it at each network upgrade.
# Without it, provider registration is off for that network.
AZTEC_MAINNET_STAKING_REGISTRY_CONTRACT=0x042df8f42790d6943f41c25c2132400fd727f452
AZTEC_MAINNET_STAKING_REGISTRY_START_BLOCK=23786843
AZTEC_STAKING_REGISTRY_CONTRACT=0xC6EcC1832c8BF6a41c927BEb4E9ec610FBeDd1C2
AZTEC_STAKING_REGISTRY_START_BLOCK=10049301

# For tests only: a fixed rollup address, used in place of the registry.
# An old rollup reports every attester as inactive. Leave these unset.
# AZTEC_MAINNET_ROLLUP_CONTRACT=
# AZTEC_ROLLUP_CONTRACT=

# --- Database --------------------------------------------------------------
# Used by docker-compose.yml for the Postgres container and the bot.
POSTGRES_PASSWORD=
# Without Docker, set the full connection string in place of the password:
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/postgres

# --- Backup ----------------------------------------------------------------
# docker-compose.yml writes one database dump a day to ./backups on the host.
# Number of dump files to keep.
# BACKUP_KEEP=14

# --- Logging ---------------------------------------------------------------
# LOG_LEVEL=info

# --- Testnet faucet --------------------------------------------------------
# A panel button in one channel that sends testnet STK on Sepolia. Off unless
# FAUCET_ENABLED=true. With the faucet on, a missing or wrong value below turns
# the faucet off and posts an alert in the admin channel. It uses
# AZTEC_RPC_URL (Sepolia) from above.
# FAUCET_ENABLED=false
# The faucet channel and the role that marks a verified member.
# FAUCET_CHANNEL_ID=
# FAUCET_VERIFIED_ROLE_ID=
# Key of the faucet wallet. It holds only the STK it hands out. Never commit it.
# FAUCET_PRIVATE_KEY=
# FAUCET_TOKEN_ADDRESS=0x5595cb9ED193cAc2C0Bc5393313bc6115817954B
# Good standing: minimum account age and minimum time in the server.
# FAUCET_MIN_ACCOUNT_DAYS=90
# FAUCET_MIN_SERVER_DAYS=7
# One fixed amount per claim. Member: once per FAUCET_MEMBER_WAIT_HOURS. Operator (testnet sequencer role): once per FAUCET_OPERATOR_WAIT_HOURS, up to FAUCET_OPERATOR_MAX_30D in 30 days.
# Whatever FAUCET_MEMBER_WAIT_HOURS is, a member gets at most one claim in any 30 days.
# FAUCET_AMOUNT=200000
# FAUCET_MEMBER_WAIT_HOURS=2160
# FAUCET_OPERATOR_WAIT_HOURS=168
# FAUCET_OPERATOR_MAX_30D=400000
# FAUCET_WALLET_MAX_30D=400000
# FAUCET_GLOBAL_MAX_24H=5000000
# Admin-channel alert when the faucet wallet holds less than this.
# FAUCET_ALERT_MIN_TOKEN=2000000
# FAUCET_ALERT_MIN_ETH=0.05
# Gas price ceiling in whole gwei. Above it a transfer fails and does not count.
# FAUCET_MAX_FEE_GWEI=100
